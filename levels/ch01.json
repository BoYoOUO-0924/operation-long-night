{
  "_說明": "第一章：雷霆空降。台詞依 docs/第一章劇本.md v2。at = 進入該段落後第幾秒；事件對白（evt_*）在事件發生時從 0 秒開始播。",
  "speakers": {
    "白鴉": "aqua",
    "戰車": "gold",
    "狐狸": "green",
    "海神": "dark_aqua",
    "守夜人": "dark_red",
    "目標": "yellow",
    "提示": "gray"
  },
  "dialogue": {
    "drop": [
      {
        "at": 1,
        "who": "海神",
        "text": "獵犬小隊，這裡是海神。你們已經進入黑石海岸上空。"
      },
      {
        "at": 5,
        "who": "海神",
        "text": "艦隊正在接近。那三座雷達不倒，我們就是瞎子。"
      },
      {
        "at": 9,
        "who": "狐狸",
        "text": "三座雷達都標進你們的目鏡了：北崖、砲台中央、燈塔頂上。"
      },
      {
        "at": 13,
        "who": "目標",
        "text": "往紅外線信標的方向降落到沙灘。"
      },
      {
        "at": 15,
        "who": "戰車",
        "text": "我先說，誰落地姿勢最醜，回去請喝一整晚。"
      },
      {
        "at": 19,
        "who": "白鴉",
        "text": "先擔心你自己別掛在崖上。信標在沙灘，對準綠光。"
      },
      {
        "at": 23,
        "who": "狐狸",
        "text": "那是紅外線信標，只有我們的目鏡看得到，敵人看不到。"
      },
      {
        "at": 27,
        "who": "白鴉",
        "text": "探照燈在掃。別讓光照到你，會引來高射砲。"
      },
      {
        "at": 30,
        "who": "狐狸",
        "text": "風往北吹，往南邊偏一點。"
      },
      {
        "at": 33,
        "who": "戰車",
        "text": "哇喔——這個高度看海景還不錯嘛！"
      },
      {
        "at": 31,
        "who": "提示",
        "text": "看著羅盤上的綠點往那個方向移動；避開探照燈的光束。"
      }
    ],
    "evt_lit": [
      {
        "at": 0,
        "who": "白鴉",
        "text": "你被照到了！往旁邊閃！"
      }
    ],
    "landed": [
      {
        "at": 0,
        "who": "白鴉",
        "text": "全員落地。沒人摔斷腿吧？"
      },
      {
        "at": 4,
        "who": "戰車",
        "text": "我落地超帥的，你們都沒看到。"
      },
      {
        "at": 8,
        "who": "狐狸",
        "text": "……我有錄影。"
      }
    ],
    "beach": [
      {
        "at": 11,
        "who": "目標",
        "text": "爬上海崖，破壞探照燈和防空砲。"
      },
      {
        "at": 14,
        "who": "白鴉",
        "text": "我找個高點掩護你們，往上走。"
      },
      {
        "at": 19,
        "who": "戰車",
        "text": "上面那門防空砲還在打我們的運輸機，先把它拆了。"
      },
      {
        "at": 70,
        "who": "提示",
        "text": "沙灘北邊有一條沿著崖壁往上的小路。"
      }
    ],
    "evt_scan": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "等一下，我開脈衝掃描……看到了嗎？發光的是巡邏兵，燈座後面那條是供電電纜。打斷它，燈就瞎了。"
      }
    ],
    "evt_light_out": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "漂亮，全場斷電。現在換我們當鬼了。"
      }
    ],
    "evt_aa_down": [
      {
        "at": 0,
        "who": "戰車",
        "text": "砲管都歪了，這下打不了鳥了。"
      }
    ],
    "evt_hack": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "外圍清空。主陣地大門的電子鎖我來開……十秒。"
      },
      {
        "at": 0,
        "who": "目標",
        "text": "掩護狐狸破解大門電子鎖。"
      }
    ],
    "evt_gate_open": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "開了。歡迎光臨黑石海岸。"
      }
    ],
    "radars": [
      {
        "at": 2,
        "who": "目標",
        "text": "炸毀三座雷達：在雷達底座安裝 C4，守住到引爆。"
      },
      {
        "at": 4,
        "who": "狐狸",
        "text": "三座我都標在羅盤上了。分頭還是一起，隊長你決定。"
      },
      {
        "at": 9,
        "who": "戰車",
        "text": "一起啦，分頭行動的都死在電影第一幕。"
      }
    ],
    "evt_plant_a": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "C4 裝好了，倒數十五秒！守住！"
      }
    ],
    "evt_boom_a": [
      {
        "at": 0,
        "who": "戰車",
        "text": "倒了！這聲音真療癒。"
      }
    ],
    "evt_near_b": [
      {
        "at": 0,
        "who": "白鴉",
        "text": "中央那座四周都有沙包，至少兩組人。"
      }
    ],
    "evt_plant_b": [
      {
        "at": 0,
        "who": "戰車",
        "text": "我頂前面，你們顧左右！"
      }
    ],
    "evt_boom_b": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "中央雷達離線！"
      }
    ],
    "evt_near_c": [
      {
        "at": 0,
        "who": "白鴉",
        "text": "燈塔窗口有反光，是狙擊手。我先處理他。"
      },
      {
        "at": 5,
        "who": "白鴉",
        "text": "……清掉了。上去。"
      }
    ],
    "evt_plant_c": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "C4 裝好了，倒數十五秒！守住樓梯口！"
      }
    ],
    "evt_boom_c": [
      {
        "at": 0,
        "who": "白鴉",
        "text": "制高點清空。"
      }
    ],
    "evt_count_1": [
      {
        "at": 3,
        "who": "海神",
        "text": "收到，第一座雷達離線。艦隊加速推進。"
      }
    ],
    "evt_count_2": [
      {
        "at": 3,
        "who": "海神",
        "text": "只剩最後一座了，獵犬。艦隊主砲裝填完畢。"
      }
    ],
    "evt_count_3": [
      {
        "at": 3,
        "who": "狐狸",
        "text": "三座全倒！海神，盲區清除了，把這片海岸炸上天吧！"
      }
    ],
    "evt_3min": [
      {
        "at": 0,
        "who": "海神",
        "text": "獵犬，還有三分鐘。時間到艦隊只能撤退。"
      }
    ],
    "evt_fail": [
      {
        "at": 0,
        "who": "海神",
        "text": "……艦隊撤退。獵犬，任務失敗。"
      },
      {
        "at": 4,
        "who": "提示",
        "text": "重新開始：已經炸掉的雷達不用再炸，倒數重設為 5 分鐘。"
      }
    ],
    "strike": [
      {
        "at": 1,
        "who": "海神",
        "text": "所有雷達離線。艦隊開火——獵犬，離開砲台！"
      },
      {
        "at": 6,
        "who": "目標",
        "text": "撤到北邊的懸崖觀測站。"
      },
      {
        "at": 9,
        "who": "戰車",
        "text": "這才叫煙火！"
      },
      {
        "at": 20,
        "who": "狐狸",
        "text": "等等……這能量讀數不對。是從山體裡面來的，而且在升高。"
      },
      {
        "at": 27,
        "who": "白鴉",
        "text": "海神，聽得到嗎？山裡面有東西——"
      },
      {
        "at": 31,
        "who": "海神",
        "text": "（劇烈雜訊）……訊號遭強電磁干擾……獵犬……"
      },
      {
        "at": 37,
        "who": "守夜人",
        "text": "雷達？你們以為我需要那種過時的玩具？"
      },
      {
        "at": 43,
        "who": "守夜人",
        "text": "歡迎來到黑石海岸，獵犬小隊。謝謝你們替我把艦隊……請進了射程。"
      },
      {
        "at": 51,
        "who": "守夜人",
        "text": "祝你們好夢。晚安。"
      },
      {
        "at": 56,
        "who": "戰車",
        "text": "這傢伙是誰？他怎麼會在我們的頻道上？"
      },
      {
        "at": 61,
        "who": "狐狸",
        "text": "不知道。但頻道全被蓋台了，連艦隊都叫不到。"
      },
      {
        "at": 66,
        "who": "白鴉",
        "text": "上北邊的懸崖觀測站，用那裡的有線線路警告艦隊。快！"
      }
    ],
    "arrive": [
      {
        "at": 0,
        "who": "戰車",
        "text": "到了。快接線！"
      }
    ]
  },
  "callouts": {
    "shelf_south": [
      "南邊岩棚有人上來！",
      "南側，一組敵人！"
    ],
    "plateau_west": [
      "西邊台地，敵人從山上下來了！",
      "西側有動靜！"
    ],
    "plateau_north": [
      "北邊有一組人！",
      "北崖那邊，敵人增援！"
    ],
    "gate_inside": [
      "大門裡面湧出來了！",
      "門內有敵人！"
    ],
    "south_cape": [
      "燈塔那邊有人！",
      "南岬，敵人！"
    ]
  },
  "callout_speakers": {
    "shelf_south": "白鴉",
    "plateau_west": "狐狸",
    "plateau_north": "白鴉",
    "gate_inside": "戰車",
    "south_cape": "白鴉"
  }
}