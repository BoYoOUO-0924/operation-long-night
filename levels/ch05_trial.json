{
  "_說明": "第五章試做關卡的對白。at = 進入該階段後第幾秒出現；who = 說話的人（顏色在 speakers 設定）。改完執行 python tools/build_level.py 再部署即可。",
  "speakers": {
    "白鴉": "aqua",
    "戰車": "gold",
    "狐狸": "green",
    "情報官": "gray",
    "守夜人": "dark_red",
    "目標": "yellow",
    "提示": "dark_aqua"
  },
  "dialogue": {
    "approach": [
      {
        "at": 3,
        "who": "戰車",
        "text": "列車就這樣翻了……我的腳趾頭已經沒感覺了。"
      },
      {
        "at": 7,
        "who": "白鴉",
        "text": "山腰上有建築。看輪廓，是舊時代的氣象站。"
      },
      {
        "at": 11,
        "who": "狐狸",
        "text": "我的掃描器在海岸那次砲擊就壞了，現在什麼都偵測不到。到站裡我得找零件修一修。"
      },
      {
        "at": 17,
        "who": "情報官",
        "text": "我們……不能停下來休息嗎？我真的走不動了。"
      },
      {
        "at": 21,
        "who": "戰車",
        "text": "走不動就用爬的。不想凍死就跟上。"
      },
      {
        "at": 25,
        "who": "白鴉",
        "text": "保持隊形，從東側的車庫進去。"
      },
      {
        "at": 28,
        "who": "目標",
        "text": "沿著山坡往上走，從氣象站東側的車庫進入。"
      },
      {
        "at": 75,
        "who": "提示",
        "text": "氣象站在山坡上方（西邊），天線塔頂端有紅燈。"
      }
    ],
    "arrival": [
      {
        "at": 1,
        "who": "狐狸",
        "text": "МЕТЕОСТАНЦИЯ №7……蘇聯時期的高山氣象站。發電機早就停了，但地熱鍋爐好像還在運轉。"
      },
      {
        "at": 6,
        "who": "戰車",
        "text": "總算有點溫度了。我先把這傢伙帶進無線電室看著。"
      },
      {
        "at": 10,
        "who": "白鴉",
        "text": "我上瞭望塔。這種天氣什麼都看不清楚，但總比沒有好。"
      },
      {
        "at": 14,
        "who": "狐狸",
        "text": "車庫裡應該有備用零件箱。幫我找找看，箱子上有個按鈕。"
      },
      {
        "at": 16,
        "who": "目標",
        "text": "在車庫找到零件箱，按下上面的按鈕。"
      },
      {
        "at": 45,
        "who": "提示",
        "text": "零件箱在車庫北側角落，有綠色光點標示。"
      }
    ],
    "reveal": [
      {
        "at": 1,
        "who": "狐狸",
        "text": "找到了！接上電源……掃描器重新啟動。"
      },
      {
        "at": 5,
        "who": "狐狸",
        "text": "等等。有訊號……就在這個房間裡。"
      },
      {
        "at": 9,
        "who": "狐狸",
        "text": "是軍用追蹤器的頻率——在他身上。"
      },
      {
        "at": 13,
        "who": "戰車",
        "text": "你這個混帳！從溺水之城開始，你就一直在替他們帶路？"
      },
      {
        "at": 17,
        "who": "情報官",
        "text": "不、不是！我根本不知道他們把那東西放進我身體裡……"
      },
      {
        "at": 21,
        "who": "白鴉",
        "text": "北邊山脊有熱源在移動。數量很多。"
      },
      {
        "at": 25,
        "who": "戰車",
        "text": "那就在他們到之前，先把叛徒解決掉。"
      },
      {
        "at": 28,
        "who": "情報官",
        "text": "你殺了我，就永遠進不了總控室！光有密鑰沒用，還需要我的視網膜和聲紋！"
      },
      {
        "at": 34,
        "who": "狐狸",
        "text": "……他說的是真的。系統紀錄裡寫著雙重生物認證。"
      },
      {
        "at": 39,
        "who": "守夜人",
        "text": "（無線電）獵犬小隊，晚安。從溺水之城一路走到這裡，辛苦你們了。"
      },
      {
        "at": 45,
        "who": "守夜人",
        "text": "（無線電）好好享受最後的溫暖吧。"
      },
      {
        "at": 49,
        "who": "戰車",
        "text": "……這筆帳我記住了。所有人，準備防守！"
      },
      {
        "at": 53,
        "who": "白鴉",
        "text": "我在塔上掩護。他們有熱成像，別在窗邊待太久。"
      }
    ],
    "prepare": [
      {
        "at": 0,
        "who": "目標",
        "text": "守住氣象站！撐到敵軍兵力耗盡。彈藥已補充。"
      },
      {
        "at": 3,
        "who": "狐狸",
        "text": "掃描器每 15 秒掃一次，我會報敵人的方向。"
      },
      {
        "at": 8,
        "who": "戰車",
        "text": "我守車庫大門，狐狸顧西門。白鴉，塔上交給你。"
      }
    ],
    "outro": [
      {
        "at": 2,
        "who": "白鴉",
        "text": "……熱源在後撤。他們退了。"
      },
      {
        "at": 6,
        "who": "狐狸",
        "text": "不是撤退，是重新部署。守夜人知道我們在這裡，我們得在天亮前離開。"
      },
      {
        "at": 12,
        "who": "戰車",
        "text": "（對情報官）你給我聽好，你的命現在是我的。開門之前敢耍花樣，我第一個斃了你。"
      },
      {
        "at": 18,
        "who": "情報官",
        "text": "……我明白。"
      },
      {
        "at": 22,
        "who": "狐狸",
        "text": "方舟的入口就在這座山底下。下一站——地下。"
      }
    ],
    "combat_start": [
      {
        "at": 0,
        "who": "白鴉",
        "text": "來了。第一組人從山下上來。"
      }
    ],
    "generator_fail": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "發電機停了！鍋爐的循環泵沒電，這裡很快就會結冰！"
      },
      {
        "at": 3,
        "who": "目標",
        "text": "到南邊的發電小屋拉起拉桿，重新啟動發電機！"
      }
    ],
    "generator_cold": [
      {
        "at": 0,
        "who": "提示",
        "text": "室內溫度持續下降……快去重啟發電機（南邊小屋）。"
      }
    ],
    "generator_fixed": [
      {
        "at": 0,
        "who": "狐狸",
        "text": "電力恢復！鍋爐重新運轉了，幹得好！"
      }
    ],
    "final_assault": [
      {
        "at": 0,
        "who": "守夜人",
        "text": "（無線電）遊戲到此為止。全員，壓上去。"
      },
      {
        "at": 3,
        "who": "白鴉",
        "text": "主力部隊！東邊有武裝皮卡，還有迫擊砲——找掩護！"
      },
      {
        "at": 6,
        "who": "目標",
        "text": "擊退主攻部隊！注意地上的紅色標記，那是砲彈落點。"
      }
    ]
  },
  "callouts": {
    "east": [
      "東邊山坡，一組人摸上來了！",
      "車庫外面有動靜，東邊！"
    ],
    "north": [
      "北側山脊下方，有一組在移動！",
      "北邊！他們想繞到側面！"
    ],
    "south": [
      "南邊高地有人，小心觀測場那邊！",
      "南側斜坡，一整組人壓下來了！"
    ],
    "west": [
      "西門外有人！他們從高處繞過來了！",
      "西邊，正對西門！"
    ],
    "northeast": [
      "東北角！天線塔那邊有一組！",
      "他們從東北包夾過來了！"
    ]
  },
  "callout_speakers": {
    "east": "戰車",
    "north": "白鴉",
    "south": "白鴉",
    "west": "狐狸",
    "northeast": "白鴉"
  }
}